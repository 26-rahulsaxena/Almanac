# Copy to .env.local and fill in. Never commit .env.local.

# Random secret that encrypts the login cookie. Generate: npx auth secret
AUTH_SECRET=

# From Google Cloud > Google Auth Platform > Clients > your Web client
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# From Supabase > Connect > Transaction pooler (port 6543), with your database password filled in
DATABASE_URL=

# 32 random bytes, base64. Encrypts Google tokens in the database. Losing it = everyone signs in again.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Web Push (VAPID). Public key is safe to show to browsers; private key is secret.
# Generate both: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services. Set to your live site URL once deployed.
VAPID_SUBJECT=
# Shared secret the minute job sends to /api/cron.
CRON_SECRET=

# The assistant. Free option: a Groq key from console.groq.com > API Keys (no card needed).
# For Google Gemini instead: key from aistudio.google.com, plus
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   AI_MODEL=gemini-3.8-flash
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Paid alternative (better answers): an Anthropic key from console.anthropic.com. Used instead of the above when set.
ANTHROPIC_API_KEY=
# Google Sheet sync: Google's file picker, so Almanac can open only the sheet you choose.
# Key: Google Cloud > APIs & Services > Credentials > Create credentials > API key (restrict it to the Google Picker API).
# Project number: Google Cloud > the project's Dashboard / Settings ("Project number", digits only).
GOOGLE_PICKER_KEY=
GOOGLE_PROJECT_NUMBER=